# Default deny: publish only reviewed source, tests, CI, and demo assets.
/*
!/batch_transparent.py
!/repair.py
!/review.py
!/README.md
!/requirements.txt
!/example.tsv
!/.gitignore
!/LICENSE

!/tests/
/tests/*
!/tests/*.py

!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/tests.yml

!/scripts/
/scripts/*
!/scripts/generate_demo.py

!/docs/
/docs/*
!/docs/images/
/docs/images/*
!/docs/images/white.png
!/docs/images/black.png
!/docs/images/transparent.png
!/docs/images/comparison.jpg

# Keep caches, environment files, and credentials private in allowed folders too.
**/__pycache__/
*.py[cod]
.env
.env.*
*.pem
*.key
.DS_Store
